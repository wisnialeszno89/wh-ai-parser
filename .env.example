# Optional AI visual observer configuration
# Keep this disabled during development to avoid API cost.
WH_AI_VISION_ENABLED=0
WH_AI_VISION_MODEL=gpt-5.6-luna
WH_AI_VISION_MIN_CONFIDENCE=0.78
WH_AI_VISION_MIN_INTERVAL_SEC=1.5
WH_AI_VISION_CACHE_DIR=outputs/vision_cache

# Set only on the machine running the agent. Never commit the real key.
# OPENAI_API_KEY=
