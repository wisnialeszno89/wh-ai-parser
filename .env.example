# Optional AI visual observer configuration
# Keep this disabled during development to avoid API cost.
WH_AI_VISION_ENABLED=0
WH_AI_VISION_MODEL=gpt-5.6-luna
WH_AI_VISION_MIN_CONFIDENCE=0.78
WH_AI_VISION_MIN_INTERVAL_SEC=1.5
WH_AI_VISION_CACHE_DIR=outputs/vision_cache

# Set only on the machine running the agent. Never commit the real key.
# OPENAI_API_KEY=

# Verification-driven reasoning model.
# Default: gpt-5.6-luna
AGENT_REASONING_MODEL=gpt-5.6-luna

# Persistent learned-workflow storage.
# Default: runtime_data/learned_workflows
# Use a machine-local path when the worker should share learned procedures.
AGENT_WORKFLOW_STORE_DIR=runtime_data/learned_workflows

# Safe WindowHub offer smoke-test values. These are non-secret test inputs.
AGENT_SMOKE_CUSTOMER=Test Client
AGENT_SMOKE_WIDTH=1230
AGENT_SMOKE_HEIGHT=1480
AGENT_SMOKE_OPENING=FIX
AGENT_SMOKE_PRODUCT=okno
AGENT_SMOKE_QUANTITY=1
AGENT_SMOKE_COLOR=Biały

# Include the current WindowHub screenshot in OpenAI task reasoning.
# Set to 0 to disable image input.
AGENT_TASK_VISION=1

# Hosted NaviMind task-reasoning bridge for WindowHub and generic Windows.
# Production endpoints must use HTTPS and share the same secret with NaviMind.
# Localhost HTTP is permitted for local development only.
# NAVIMIND_AGENT_URL=https://your-deployment.example/api/agent/task
# NAVIMIND_AGENT_SECRET=
# NAVIMIND_AGENT_TIMEOUT_SECONDS=45

# Explicit OpenAI task-reasoner alternative, used only when NaviMind URL is absent.
# Requires OPENAI_API_KEY. No automatic fallback occurs after NaviMind fails.
AGENT_TASK_REASONING=0

# Optional verification-driven replanning provider; off unless explicitly enabled.
# Requires OPENAI_API_KEY when enabled.
AGENT_PLAN_REASONING=0

# Generic Windows agent physical execution is DRY_RUN unless set to 1.
COMPUTER_REAL=0

NAVIMIND_AGENT_RESEARCH_ENABLED=0
NAVIMIND_RESEARCH_MAX_RESULTS=5
NAVIMIND_RESEARCH_DEPTH=basic
NAVIMIND_RESEARCH_TOPIC=general

# Durable model-safe agent experience memory
AGENT_MEMORY_STORE_DIR=runtime_data/agent_memory

# Explicit workspace root for the Universal Agent filesystem adapter
AGENT_FILESYSTEM_ROOT=runtime_data/workspace


# Browser automation provider (disabled by default).
AGENT_BROWSER_ENABLED=0
AGENT_BROWSER_HEADLESS=1
AGENT_BROWSER_TYPE=chromium
AGENT_BROWSER_DRY_RUN=1
AGENT_BROWSER_ALLOWED_DOMAINS=
# Optional dedicated persistent browser profile.
# AGENT_BROWSER_USER_DATA_DIR=runtime_data/browser_profile
