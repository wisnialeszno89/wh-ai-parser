# Optional AI visual observer configuration
# Keep this disabled during development to avoid API cost.
WH_AI_VISION_ENABLED=0
WH_AI_VISION_MODEL=gpt-5.6-luna
WH_AI_VISION_MIN_CONFIDENCE=0.78
WH_AI_VISION_MIN_INTERVAL_SEC=1.5
WH_AI_VISION_CACHE_DIR=outputs/vision_cache

# Set only on the machine running the agent. Never commit the real key.
# OPENAI_API_KEY=

# Verification-driven reasoning model.
# Default: gpt-5.6-luna
AGENT_REASONING_MODEL=gpt-5.6-luna

# Safe WindowHub offer smoke-test values. These are non-secret test inputs.
AGENT_SMOKE_CUSTOMER=Test Client
AGENT_SMOKE_WIDTH=1230
AGENT_SMOKE_HEIGHT=1480
AGENT_SMOKE_OPENING=FIX
AGENT_SMOKE_PRODUCT=okno
AGENT_SMOKE_QUANTITY=1
AGENT_SMOKE_COLOR=Biały
